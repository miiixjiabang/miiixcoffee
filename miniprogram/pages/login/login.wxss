.login-page {
  min-height: 100vh;
  background: #FAFAFA;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.logo-circle {
  width: 120rpx;
  height: 120rpx;
  background: #1A1A1A;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.logo-text {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
}

.brand-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.brand-sub {
  font-size: 26rpx;
  color: #999999;
}

.form-section {
  width: 100%;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #FFFFFF;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #1A1A1A;
}

.error-text {
  color: #EF4444;
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.login-btn {
  background: #1A1A1A !important;
  color: #FFFFFF !important;
  border-radius: 16rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  padding: 28rpx 0 !important;
  margin-top: 16rpx;
}

.login-btn:active {
  opacity: 0.8;
}

.hint-text {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 2;
}