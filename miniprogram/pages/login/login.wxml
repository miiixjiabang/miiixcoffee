<view class="login-page">
  <!-- Logo -->
  <view class="logo-section">
    <view class="logo-circle">
      <text class="logo-text">M</text>
    </view>
    <text class="brand-name">Miiix Coffee</text>
    <text class="brand-sub">物料盘点管理系统</text>
  </view>

  <!-- 表单 -->
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">账号</text>
      <input 
        class="form-input" 
        placeholder="请输入账号" 
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>
    <view class="form-item">
      <text class="form-label">密码</text>
      <input 
        class="form-input" 
        placeholder="请输入密码" 
        password="{{true}}"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view wx:if="{{error}}" class="error-text">{{error}}</view>

    <button 
      class="login-btn" 
      bindtap="handleLogin"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '登 录'}}
    </button>

    <view class="hint-text">
      <text>预置账号：admin/123456（店长）</text>
      <text>staff/123456（店员）</text>
    </view>
  </view>
</view>