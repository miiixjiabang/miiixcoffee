.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.user-role {
  font-size: 24rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.logout-btn {
  font-size: 26rpx;
  color: #999999;
}

.pending-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FEF2F2;
  border: 2rpx solid #FECACA;
}

.pending-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.pending-icon {
  width: 64rpx;
  height: 64rpx;
  background: #EF4444;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.pending-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
}

.pending-desc {
  font-size: 24rpx;
  color: #666666;
}

.pending-arrow {
  font-size: 32rpx;
  color: #999999;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.action-icon {
  font-size: 48rpx;
}

.action-text {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: block;
}

.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
  display: block;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-date {
  font-size: 28rpx;
  color: #1A1A1A;
}

.record-type {
  font-size: 22rpx;
  color: #999999;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.record-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}