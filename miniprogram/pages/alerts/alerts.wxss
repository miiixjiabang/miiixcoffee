.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: block;
}

.alert-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.alert-item:last-child {
  border-bottom: none;
}

.alert-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.alert-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.alert-category {
  font-size: 22rpx;
  color: #999999;
}

.alert-values {
  display: flex;
  gap: 24rpx;
}

.alert-current {
  font-size: 24rpx;
  color: #EF4444;
  font-weight: 600;
}

.alert-threshold {
  font-size: 24rpx;
  color: #999999;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
}

.placeholder {
  color: #999999;
}

.arrow {
  font-size: 20rpx;
  color: #999999;
}

.save-btn {
  background: #1A1A1A !important;
  color: #FFFFFF !important;
  border-radius: 16rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}