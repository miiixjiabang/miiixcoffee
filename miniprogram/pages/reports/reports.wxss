.time-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.time-picker {
  flex: 1;
  background: #FFFFFF;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  text-align: center;
}

.time-sep {
  font-size: 24rpx;
  color: #999999;
}

.query-btn {
  background: #1A1A1A !important;
  color: #FFFFFF !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  padding: 20rpx 32rpx !important;
  line-height: 1.5 !important;
}

.export-section {
  margin-bottom: 24rpx;
}

.export-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.export-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.export-btn {
  flex: 1;
  min-width: calc(50% - 8rpx) !important;
  background: #1A1A1A !important;
  color: #FFFFFF !important;
  border: none !important;
  border-radius: 16rpx !important;
  font-size: 26rpx !important;
  padding: 20rpx 0 !important;
  line-height: 1.5 !important;
  text-align: center !important;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  display: block;
}

.table-scroll {
  white-space: nowrap;
}

.table {
  min-width: 100%;
}

.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #1A1A1A;
  font-weight: 600;
  font-size: 24rpx;
  color: #1A1A1A;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  font-size: 26rpx;
}

.col-date {
  flex: 2;
}

.col-num {
  flex: 1;
  text-align: right;
}

.trend-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.trend-item:last-child {
  border-bottom: none;
}

.trend-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.trend-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.trend-category {
  font-size: 22rpx;
  color: #999999;
}

.trend-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.trend-data {
  font-size: 22rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
}